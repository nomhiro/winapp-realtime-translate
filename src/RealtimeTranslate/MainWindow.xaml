<Window x:Class="RealtimeTranslate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="リアルタイム翻訳" Height="720" Width="520"
        MinHeight="360" MinWidth="360"
        FontFamily="Yu Gothic UI"
        Topmost="{Binding AlwaysOnTop}"
        Opacity="{Binding WindowOpacity}"
        FontSize="{Binding FontSize}"
        Background="#1E1E1E">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- ツールバー -->
        <Border DockPanel.Dock="Top" Background="#2D2D30" Padding="6">
            <WrapPanel Orientation="Horizontal">
                <Button x:Name="AudioButton" Content="{Binding AudioButtonText}" MinWidth="110"
                        Margin="2" Padding="8,4" Click="OnToggleAudio"/>
                <Button Content="{Binding ScreenModeText}" MinWidth="120"
                        Margin="2" Padding="8,4" Click="OnToggleMode"/>
                <Button Content="今すぐ翻訳" Margin="2" Padding="8,4" Click="OnTranslateNow"
                        ToolTip="アクティブなブラウザを今すぐ1回翻訳します"/>
                <Button Content="A-" Margin="2" Padding="8,4" Click="OnFontMinus"/>
                <Button Content="A+" Margin="2" Padding="8,4" Click="OnFontPlus"/>
                <CheckBox Content="最前面" IsChecked="{Binding AlwaysOnTop}" Foreground="White"
                          VerticalAlignment="Center" Margin="8,2,2,2"/>
                <CheckBox Content="原文" IsChecked="{Binding ShowOriginal}" Foreground="White"
                          VerticalAlignment="Center" Margin="4,2,2,2"/>
                <Button Content="設定" Margin="2" Padding="8,4" Click="OnOpenSettings"/>
            </WrapPanel>
        </Border>

        <!-- ステータスバー -->
        <Border DockPanel.Dock="Bottom" Background="#007ACC" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="White" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding TargetBrowserText}" Foreground="#D0E8FF" FontSize="12"/>
            </Grid>
        </Border>

        <!-- 本体: 上=字幕(音声) / 下=画面テキスト -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 音声字幕パネル -->
            <DockPanel Grid.Row="0">
                <TextBlock DockPanel.Dock="Top" Text="🔊 音声翻訳" Foreground="#9CDCFE"
                           FontWeight="Bold" Margin="8,6,8,2" FontSize="13"/>
                <Border DockPanel.Dock="Bottom" Background="#252526" Padding="8,4" Margin="8,2,8,6"
                        BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="3">
                    <StackPanel>
                        <TextBlock Text="{Binding InterimSubtitle.Original}" Foreground="#808080"
                                   FontStyle="Italic"
                                   Visibility="{Binding ShowOriginal, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding InterimSubtitle.Translation}" Foreground="#C0C0C0"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="SubtitleList" ItemsSource="{Binding Subtitles}"
                         Background="#1E1E1E" BorderThickness="0" Margin="8,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0,2"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Left"
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                <TextBlock Text="{Binding Original}" Foreground="#808080" TextWrapping="Wrap"
                                           Visibility="{Binding DataContext.ShowOriginal, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Translation}" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch"
                          Background="#3F3F46"/>

            <!-- 画面テキストパネル -->
            <DockPanel Grid.Row="2">
                <TextBlock DockPanel.Dock="Top" Text="🖥 画面テキスト" Foreground="#9CDCFE"
                           FontWeight="Bold" Margin="8,6,8,2" FontSize="13"/>
                <ListBox x:Name="ScreenList" ItemsSource="{Binding ScreenTexts}"
                         Background="#1E1E1E" BorderThickness="0" Margin="8,0,8,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0,4"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252526" Padding="8,6" CornerRadius="3" Margin="0,2"
                                    HorizontalAlignment="Left"
                                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Original}" Foreground="#9A9A9A" TextWrapping="Wrap"
                                               Visibility="{Binding DataContext.ShowOriginal, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Translation}" Foreground="White" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
